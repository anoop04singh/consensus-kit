{
  "name": "consensus-kit",
  "description": "Verifiable HCS events with PostgreSQL projections and an interactive setup wizard",
  "version": "0.1.0",
  "create-scaffold-hbar": {
    "requirements": {
      "node": ">=20.18.3"
    },
    "rename": {
      "\"lint:core\":": {
        "to": "\"lint\":",
        "paths": [
          "."
        ]
      },
      "\"format:core\":": {
        "to": "\"format\":",
        "paths": [
          "."
        ]
      },
      "\"name\": \"consensus-kit\"": {
        "to": "\"name\": \"{{projectName}}\"",
        "paths": [
          "."
        ]
      },
      "ConsensusKit project": {
        "to": "{{projectName}}",
        "paths": [
          "."
        ]
      }
    },
    "capabilities": {
      "frontend": [
        "none"
      ],
      "solidityFramework": [
        "none"
      ],
      "packageManager": [
        "npm"
      ]
    },
    "defaults": {
      "frontend": "none",
      "solidityFramework": "none",
      "packageManager": "npm"
    },
    "outro": {
      "sections": [
        {
          "title": "Configure your project",
          "steps": [
            {
              "label": "Interactive testnet setup",
              "command": "{run:setup}"
            },
            {
              "text": "Enter your credentials and database URL. Setup can create a topic and run your registered migrations."
            }
          ]
        },
        {
          "title": "Define your application",
          "steps": [
            {
              "text": "Register your projectors in consensus.projectors.ts and your domain SQL in scripts/migrations.ts."
            },
            {
              "text": "Read docs/customization.md to replace the tasks example or start with only the infrastructure."
            }
          ]
        },
        {
          "title": "Run the event infrastructure",
          "steps": [
            {
              "label": "Terminal 1: index your topic",
              "command": "{run:consensus:indexer}"
            },
            {
              "label": "Terminal 2: inspect events",
              "command": "{run:dev}"
            },
            {
              "label": "Optional: try the bundled tasks example",
              "command": "{run:example:publish}"
            }
          ]
        }
      ],
      "installCommand": "npm ci"
    }
  }
}

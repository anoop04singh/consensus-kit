{
  "name": "consensus-kit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20.18.3" },
  "scripts": {
    "dev": "tsx packages/frontend/server.ts",
    "build": "tsc --noEmit && vite build --config packages/frontend/vite.config.ts --configLoader runner",
    "lint": "eslint .",
    "test": "vitest run",
    "db:migrate": "tsx scripts/migrate.ts",
    "consensus:topic:create": "tsx scripts/create-topic.ts",
    "consensus:indexer": "tsx packages/indexer/worker.ts",
    "consensus:rebuild": "tsx packages/indexer/rebuild.ts",
    "consensus:proof": "tsx scripts/testnet-proof.ts",
    "example:publish": "tsx packages/example/publish.ts"
  },
  "dependencies": {
    "@hiero-ledger/sdk": "^2.77.0",
    "dotenv": "^16.6.1",
    "pg": "^8.16.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.5",
    "eslint": "^9.34.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vite": "^7.1.4",
    "vitest": "^3.2.4"
  }
}

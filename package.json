{
  "name": "consensus-kit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20.18.3"
  },
  "scripts": {
    "setup": "tsx scripts/setup.ts",
    "dev": "tsx packages/frontend/server.ts",
    "build": "tsc --noEmit && vite build --config packages/frontend/vite.config.ts --configLoader runner",
    "lint": "eslint .",
    "lint:core": "eslint .",
    "test": "vitest run --exclude \"**/.verification/**\"",
    "db:migrate": "tsx scripts/migrate.ts",
    "consensus:topic:create": "tsx scripts/create-topic.ts",
    "consensus:indexer": "tsx scripts/indexer.ts",
    "consensus:rebuild": "tsx scripts/rebuild.ts",
    "consensus:proof": "tsx scripts/testnet-proof.ts",
    "example:publish": "tsx packages/example/publish.ts",
    "format": "prettier --write .",
    "format:core": "prettier --write ."
  },
  "dependencies": {
    "@hiero-ledger/sdk": "^2.77.0",
    "@inquirer/prompts": "7.10.1",
    "dotenv": "^16.6.1",
    "pg": "^8.16.3",
    "protobufjs": "8.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.5",
    "eslint": "^9.34.0",
    "prettier": "3.9.9",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vite": "6.4.3",
    "vitest": "^3.2.4"
  }
}
